FROM aiinfos/vllm-gfx906-mobydick:latest

# Fix ForCausalLM WeightsMapper: strip language_model. prefix, drop vision weights
# Fix load_weights: pass mapper to AutoWeightsLoader
COPY vllm/models/minimax_m3/amd/model.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/minimax_m3/amd/model.py

# Fix indexer kernel: cast bf16→fp16 before tl.dot (gfx906 has no bf16 matmul)
COPY vllm/models/minimax_m3/common/ops/index_topk.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/minimax_m3/common/ops/index_topk.py

# DeepSeek-V4: replace hardcoded bf16 with platform-aware dtype (fp16 on gfx906)
COPY vllm/model_executor/kernels/mhc/tilelang.py \
     /usr/local/lib/python3.12/dist-packages/vllm/model_executor/kernels/mhc/tilelang.py
COPY vllm/model_executor/kernels/mhc/tilelang_kernels.py \
     /usr/local/lib/python3.12/dist-packages/vllm/model_executor/kernels/mhc/tilelang_kernels.py
COPY vllm/model_executor/kernels/mhc/torch.py \
     /usr/local/lib/python3.12/dist-packages/vllm/model_executor/kernels/mhc/torch.py
COPY vllm/model_executor/layers/mhc.py \
     /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mhc.py
COPY vllm/models/deepseek_v4/amd/rocm.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/amd/rocm.py
COPY vllm/models/deepseek_v4/attention.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/attention.py
COPY vllm/models/deepseek_v4/sparse_mla.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/sparse_mla.py
COPY vllm/models/deepseek_v4/common/ops/cache_utils.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/common/ops/cache_utils.py
COPY vllm/models/deepseek_v4/common/ops/fused_compress_quant_cache.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/common/ops/fused_compress_quant_cache.py
COPY vllm/models/deepseek_v4/common/ops/fused_indexer_q.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/common/ops/fused_indexer_q.py
COPY vllm/models/deepseek_v4/common/ops/fused_qk_rmsnorm.py \
     /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/common/ops/fused_qk_rmsnorm.py
COPY vllm/v1/attention/ops/rocm_aiter_mla_sparse.py \
     /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py

# Clear any baked-in Triton cache so patched kernels recompile
RUN rm -rf /root/.triton/cache
